rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 128)) &&
             (!('pinnedTheme' in data) || data.pinnedTheme == null || (data.pinnedTheme is string && data.pinnedTheme.size() <= 32)) &&
             (!('isDarkMode' in data) || data.isDarkMode is bool) &&
             (!('aiPersonalisationConsent' in data) || data.aiPersonalisationConsent is bool);
    }

    function isValidMoodEntry(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.mood is string && data.mood.size() > 0 && data.mood.size() <= 32 &&
             data.valence is int && data.valence >= 1 && data.valence <= 10 &&
             data.intensity is int && data.intensity >= 1 && data.intensity <= 10 &&
             (!('tags' in data) || (data.tags is string && data.tags.size() <= 500)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 5000));
    }

    function isValidJournalEntry(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 50000 &&
             (!('associatedMood' in data) || data.associatedMood == null || (data.associatedMood is string && data.associatedMood.size() <= 32)) &&
             (!('tags' in data) || (data.tags is string && data.tags.size() <= 500)) &&
             (!('wordCount' in data) || data.wordCount is int);
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.senderRole is string && (data.senderRole == 'user' || data.senderRole == 'model') &&
             data.content is string && data.content.size() <= 20000 &&
             (!('modelName' in data) || (data.modelName is string && data.modelName.size() <= 64)) &&
             (!('systemRole' in data) || (data.systemRole is string && data.systemRole.size() <= 64));
    }

    function isValidAudioTranscription(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.transcription is string && data.transcription.size() <= 20000 &&
             (!('durationSeconds' in data) || data.durationSeconds is int) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 64));
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidUserProfile(incoming());

      allow delete: if isOwner(userId);

      // Subcollection: Mood Entries
      match /mood_entries/{entryId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidMoodEntry(incoming());

        allow update: if isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidMoodEntry(incoming());

        allow delete: if isOwner(userId);
      }

      // Subcollection: Journal Entries
      match /journal_entries/{journalId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidJournalEntry(incoming());

        allow update: if isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidJournalEntry(incoming());

        allow delete: if isOwner(userId);
      }

      // Subcollection: Chat Messages
      match /chat_messages/{messageId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidChatMessage(incoming());

        allow update: if false; // Chat history is immutable

        allow delete: if isOwner(userId);
      }

      // Subcollection: Audio Transcriptions
      match /audio_transcriptions/{transcriptionId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidAudioTranscription(incoming());

        allow update: if isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         isValidAudioTranscription(incoming());

        allow delete: if isOwner(userId);
      }
    }
  }
}
